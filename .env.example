# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/phytotree?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="your-access-secret-key-min-32-chars-long"
JWT_REFRESH_SECRET="your-refresh-secret-key-min-32-chars-long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Telegram Bot
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_BOT_USERNAME="your_bot_username" // without "@"
BOT_INTERNAL_SECRET="your-internal-secret-for-bot-to-backend-communication"

# Webhook
WEBHOOK_DOMAIN="https://your-domain.com" // use Ngrok for development env
WEBHOOK_PATH="/api/telegram/webhook"

# App
PORT=3000
NODE_ENV="development"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Admin seed (Telegram user ID for initial admin)
ADMIN_TELEGRAM_USER_ID="123456789" // @RawDataBot - to get userId

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Click Payment Gateway
CLICK_SERVICE_ID="12345"
CLICK_MERCHANT_ID="12345"
CLICK_SECRET_KEY="your-click-secret-key"
CLICK_RETURN_URL="https://your-domain.com/orders/payment-result"
