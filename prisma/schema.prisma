// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  PENDING           // Ожидает оплаты
  AWAITING_PAYMENT  // Пользователь перешёл на страницу оплаты
  PAID              // Оплачен
  PROCESSING        // В обработке
  SHIPPED           // Отправлен
  DELIVERED         // Доставлен
  CANCELLED         // Отменён
  REFUNDED          // Возврат средств
}

enum PaymentStatus {
  PENDING     // Ожидает
  PROCESSING  // В процессе (prepare получен)
  COMPLETED   // Завершён успешно
  FAILED      // Ошибка
  CANCELLED   // Отменён
  REFUNDED    // Возврат
}

enum PaymentProvider {
  CLICK
  PAYME   // На будущее
  UZCARD  // На будущее
}

model User {
  id             String         @id @default(uuid())
  telegramUserId BigInt         @unique @map("telegram_user_id")
  firstName      String?        @map("first_name")
  lastName       String?        @map("last_name")
  username       String?
  photoUrl       String?        @map("photo_url")
  phoneNumber    String?        @map("phone_number")
  role           Role           @default(CUSTOMER)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  cartItems      CartItem[]
  wishlistItems  WishlistItem[]
  orders         Order[]

  @@map("users")
}

model ProductCategory {
  id        String    @id @default(uuid())
  slug      String    @unique
  nameRu    String    @map("name_ru")
  nameEn    String    @map("name_en")
  nameUz    String    @map("name_uz")
  imageUrl  String?   @map("image_url")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]

  @@map("product_categories")
}

model Product {
  id            String          @id @default(uuid())
  slug          String          @unique
  categoryId    String          @map("category_id")
  category      ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  nameRu        String          @map("name_ru")
  nameEn        String          @map("name_en")
  nameUz        String          @map("name_uz")
  descriptionRu String?         @map("description_ru")
  descriptionEn String?         @map("description_en")
  descriptionUz String?         @map("description_uz")
  price         Decimal         @db.Decimal(10, 2)
  images        String[]        @default([])
  inStock       Boolean         @default(true) @map("in_stock")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]

  @@index([categoryId])
  @@index([inStock])
  @@map("products")
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, productId])
  @@index([userId])
  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique @map("order_number")
  userId          String      @map("user_id")
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Контактная информация
  customerName    String      @map("customer_name")
  customerPhone   String      @map("customer_phone")

  // Адрес доставки
  shippingAddress String?     @map("shipping_address")
  shippingCity    String?     @map("shipping_city")
  shippingNote    String?     @map("shipping_note")

  // Финансы
  subtotal        Decimal     @db.Decimal(12, 2)
  shippingCost    Decimal     @default(0) @map("shipping_cost") @db.Decimal(12, 2)
  totalAmount     Decimal     @map("total_amount") @db.Decimal(12, 2)

  // Статус
  status          OrderStatus @default(PENDING)

  // Связи
  items           OrderItem[]
  payments        Payment[]

  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  paidAt          DateTime?   @map("paid_at")

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String   @map("order_id")
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String   @map("product_id")
  product      Product  @relation(fields: [productId], references: [id])

  // Снэпшот данных на момент заказа
  productName  String   @map("product_name")
  productPrice Decimal  @map("product_price") @db.Decimal(10, 2)
  quantity     Int
  totalPrice   Decimal  @map("total_price") @db.Decimal(12, 2)

  createdAt    DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id                  String          @id @default(uuid())
  orderId             String          @map("order_id")
  order               Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  provider            PaymentProvider
  status              PaymentStatus   @default(PENDING)
  amount              Decimal         @db.Decimal(12, 2)

  // Click-специфичные поля
  clickTransId        BigInt?         @unique @map("click_trans_id")
  clickPaydocId       BigInt?         @map("click_paydoc_id")
  merchantPrepareId   String?         @map("merchant_prepare_id")
  merchantConfirmId   String?         @map("merchant_confirm_id")

  // Для отслеживания
  prepareTime         DateTime?       @map("prepare_time")
  completeTime        DateTime?       @map("complete_time")
  cancelTime          DateTime?       @map("cancel_time")
  cancelReason        Int?            @map("cancel_reason")

  // Логирование запросов
  rawPrepareRequest   Json?           @map("raw_prepare_request")
  rawCompleteRequest  Json?           @map("raw_complete_request")

  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([status])
  @@map("payments")
}
